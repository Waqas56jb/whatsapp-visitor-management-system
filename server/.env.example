PORT=5000
JWT_SECRET=change-me-to-a-long-random-string
TABLE_PREFIX=whatsapp_visitor_management_

# Supabase Postgres (pooler recommended)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require

# Optional individual fields (used if DATABASE_URL is empty)
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=

ADMIN_ORIGIN=https://authentic-vision-production-7a37.up.railway.app
CORS_ORIGINS=

# Shown on visitor approval messages (optional)
ORG_LOCATION=Botho Innovations

# WhatsApp assistant (server-side only)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Admin app address; the visitor pass page /pass/<token> encoded into the QR is served there
PUBLIC_PASS_URL=https://authentic-vision-production-7a37.up.railway.app


PORT=5000
JWT_SECRET=change-me-to-a-long-random-string
TABLE_PREFIX=whatsapp_visitor_management_

# Supabase Postgres (pooler recommended)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres?sslmode=require

# Optional individual fields (used if DATABASE_URL is empty)
SUPABASE_DB_HOST=
SUPABASE_DB_PORT=6543
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=
SUPABASE_DB_PASSWORD=

CLIENT_ORIGIN=https://marvelous-determination-production-9ce0.up.railway.app
ADMIN_ORIGIN=https://authentic-vision-production-7a37.up.railway.app
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://marvelous-determination-production-9ce0.up.railway.app,https://authentic-vision-production-7a37.up.railway.app

# Shown on visitor approval messages (optional)
ORG_LOCATION=Botho Innovations

# Host portal AI agent (server-side only — never put this in /client)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Public visitor pass page encoded into the QR (usually the client site)
PUBLIC_PASS_URL=http://localhost:5173

